{
  "name": "zim-school-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "ENV_FILE=.env.test vitest run",
    "test:watch": "ENV_FILE=.env.test vitest",
    "db:generate": "drizzle-kit generate --config drizzle.platform.config.ts && drizzle-kit generate --config drizzle.school.config.ts",
    "db:setup": "tsx --conditions=react-server scripts/db-setup.ts",
    "db:migrate:platform": "tsx --conditions=react-server scripts/school-admin.ts migrate-platform",
    "db:migrate:schools": "tsx --conditions=react-server scripts/school-admin.ts migrate-all",
    "db:seed": "tsx --conditions=react-server scripts/seed-dev.ts",
    "school": "tsx --conditions=react-server scripts/school-admin.ts",
    "db:reset": "tsx --conditions=react-server scripts/db-reset.ts",
    "backup": "tsx --conditions=react-server scripts/backup.ts",
    "restore": "tsx --conditions=react-server scripts/restore.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "lru-cache": "^11.5.3",
    "next": "16.4.3",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
