# Copy to .env for local development:  cp .env.example .env
# NEVER commit a real .env. Production secrets come from the secrets manager.

# --- Platform database -------------------------------------------------------
# Least-privilege role used by the running app (no DDL, no UPDATE/DELETE on audit).
PLATFORM_DATABASE_URL=postgres://platform_app:platform_app_dev@localhost:5432/platform_core
# Owner role used ONLY by migrations (scripts/migrate-platform.ts).
PLATFORM_MIGRATOR_URL=postgres://postgres:devpostgres@localhost:5432/platform_core
# Password the setup script gives the platform_app role in development.
PLATFORM_APP_PASSWORD=platform_app_dev

# --- School databases --------------------------------------------------------
# Admin connection used ONLY by provisioning/migration jobs to create databases
# and roles. Must point at the "postgres" maintenance database.
PROVISIONER_DATABASE_URL=postgres://postgres:devpostgres@localhost:5432/postgres
# Where the app connects to school databases. In production this is PgBouncer.
SCHOOL_DB_HOST=localhost
SCHOOL_DB_PORT=5432
# Prefix for school database and role names (school_0001, school_0001_app ...).
SCHOOL_DB_PREFIX=school_
# 32 random bytes, base64. Encrypts school DB passwords stored in platform_core.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SCHOOL_DB_ENCRYPTION_KEY=

# --- Tenant client cache -----------------------------------------------------
TENANT_CACHE_MAX_SCHOOLS=200
TENANT_POOL_MAX=3

# --- Auth --------------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Backups -----------------------------------------------------------------
# 32 random bytes, base64. Store separately from the backup files themselves.
BACKUP_ENCRYPTION_KEY=

# --- Brute-force protection --------------------------------------------------
# Header with the real client IP, set and OVERWRITTEN by your own proxy/load balancer.
AUTH_CLIENT_IP_HEADER=x-forwarded-for
AUTH_SIGNIN_MAX_PER_MINUTE=5
AUTH_ACCOUNT_LOCKOUT_FAILURES=10

# Two-factor authentication is REQUIRED for headmaster, administrators and accounts
# staff unless this is "false". Keep it unset/true in staging and production.
REQUIRE_MFA_FOR_PRIVILEGED=false
# Private file uploads (local disk driver). Use a persistent volume in production.
FILE_STORAGE_DIR=./storage
